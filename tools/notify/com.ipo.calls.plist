<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ipo.calls</string>
  <!-- RunAtLoad: fire a catch-up run shortly after login (covers a 9:30/14:30/20:30 slot missed because the
       Mac was off/logged-out). The pipeline is idempotent gap-fill + .notified dedup, so an extra run is a
       harmless no-op when nothing was missed. -->
  <key>RunAtLoad</key><true/>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/swapnilagarwal/Visual_Studio_Projects/ipo-analysis/.venv/bin/python</string>
    <string>/Users/swapnilagarwal/Visual_Studio_Projects/ipo-analysis/tools/notify/notify_calls.py</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>WorkingDirectory</key><string>/Users/swapnilagarwal/Visual_Studio_Projects/ipo-analysis</string>
  <key>StandardOutPath</key><string>/tmp/ipo_calls_notify.log</string>
  <key>StandardErrorPath</key><string>/tmp/ipo_calls_notify.err</string>
</dict>
</plist>
